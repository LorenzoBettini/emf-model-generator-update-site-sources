<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.github.lorenzobettini</groupId>
		<artifactId>emf.model.generator.parent</artifactId>
		<version>1.0.0</version>
	</parent>

	<artifactId>emf.model.generator.repository</artifactId>
	<packaging>eclipse-repository</packaging>

	<name>EMF Model Generator Repository</name>
	<description>p2 update site for EMF Model Generator.</description>

	<build>
		<plugins>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-p2-repository-plugin</artifactId>
				<configuration>
					<repositoryName>EMF Model Generator</repositoryName>
					<includeAllSources>true</includeAllSources>
					<compress>true</compress>
					<xzCompress>true</xzCompress>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.6.4</version>
				<!-- The repository module has no Java compilation lifecycle. Launch the
				     helper directly with Java 21 source-file mode instead of exec:java,
				     which requires an already compiled class on the project classpath. -->
				<executions>
					<execution>
						<id>update-composite-metadata</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>${java.home}/bin/java</executable>
							<arguments>
								<argument>${project.basedir}/build-tools/UpdateCompositeMetadata.java</argument>
								<argument>${project.version}</argument>
								<argument>${project.basedir}/composite/compositeContent.xml</argument>
								<argument>${project.basedir}/composite/compositeArtifacts.xml</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.5.0</version>
				<executions>
					<execution>
						<id>copy-composite-metadata</id>
						<phase>verify</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/composite</outputDirectory>
							<overwrite>true</overwrite>
							<resources>
								<resource>
									<directory>${project.basedir}/composite</directory>
									<filtering>false</filtering>
								</resource>
							</resources>
						</configuration>
					</execution>
					<execution>
						<id>copy-repository-to-composite</id>
						<phase>verify</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/composite/${project.version}</outputDirectory>
							<overwrite>true</overwrite>
							<resources>
								<resource>
									<directory>${project.build.directory}/repository</directory>
									<filtering>false</filtering>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
